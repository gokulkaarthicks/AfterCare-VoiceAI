# AfterCare — environment template
#   cp .env.example .env
# Only the two required keys below must be real before making any LLM call.

# --- LLM (OpenRouter, OpenAI-compatible) --------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# --- Twilio Programmable Voice ------------------------------------------------
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=+10000000000
# Public HTTPS origin of the Communication Agent (port 8002), no path.
# Local testing: `ngrok http 8002` → https://<id>.ngrok-free.app
# Twilio cannot reach localhost, so webhooks silently fail until this is public.
TWILIO_WEBHOOK_BASE_URL=http://localhost:8002

# --- Optional ElevenLabs narration (otherwise Twilio Polly) -------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- Runtime ------------------------------------------------------------------
# DEMO_MODE=true compresses clinical follow-up spacing into minutes.
DEMO_MODE=true
# REDIS_SESSION_TTL_SECONDS=3600

# --- Infrastructure (host defaults; docker compose overrides inside containers)
# RABBITMQ_URL=amqp://guest:guest@localhost/
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=sqlite+aiosqlite:///./aftercare.db

# --- Inter-service URLs (host defaults) ---------------------------------------
# CARE_AGENT_URL=http://localhost:8001
# COMM_AGENT_URL=http://localhost:8002
# DB_SERVICE_URL=http://localhost:8003
# SCHEDULER_URL=http://localhost:8004
